
{
  "expo": {
    "name": "Fynage",
    "slug": "Fynage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fynage-app-icon.png",
    "scheme": "fynage",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fynage-app-icon.png"
    },
    "android": {
      "permissions": [
        "android.permission.READ_SMS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/fynage-android-foreground.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.armament.fynage"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fynage-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.21",
            "manifestQueries": {
              "package": [
                "com.armament.murimi",
                "com.armament.tengesa",
                "com.yayapana.TransixNewVersion"
              ]
            }
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/fynage-mark.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#0F0E11",
            "image": "./assets/images/fynage-mark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/analytics",
      "./plugins/withFirebaseAndroidBom",
      "./plugins/withKotlinCompiler",
      "expo-sharing",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e975e470-1faa-4ccd-a667-24c6499f5e3e"
      }
    }
  }
}
